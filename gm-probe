#!/usr/bin/env python3
"""gm-probe 可执行入口。

用法：
    ./gm-probe /path/to/model            # 探测 + 报告
    ./gm-probe /path/to/model --write    # 写回 models.json
    ./gm-probe /path/to/model --sweep    # 附带 n_draft 实测扫描

等价于 `python3 -m gm.probe_cli`，但省去指定模块名的麻烦。
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from gm.probe_cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
